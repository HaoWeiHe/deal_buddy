# Claude（沒有這個就跑離線模式：關鍵字抽取 + 規則式對話）
ANTHROPIC_API_KEY=
# DEALBUDDY_AGENT_MODEL=claude-sonnet-5-5
# DEALBUDDY_EXTRACT_MODEL=claude-haiku-4-5
# DEALBUDDY_AGENT_EFFORT=medium

# Telegram bot（跟 @BotFather 申請）
TELEGRAM_BOT_TOKEN=

# 資料庫與時區
DEALBUDDY_DB=dealbuddy.sqlite3
DEALBUDDY_TZ=America/Toronto
DEALBUDDY_DIGEST_HOUR=11
# 網頁版的共用密碼（可選）：打開 http://localhost:8000/?token=xxx
DEALBUDDY_APP_TOKEN=

# 小紅書：自己跑 xiaohongshu-mcp（github.com/xpzouying/xiaohongshu-mcp），用專用小號登入
XHS_MCP_URL=http://localhost:18060
XHS_MCP_TOKEN=
# 額外的搜尋關鍵字（逗號分隔）；城市關鍵字和使用者意圖會自動加上
XHS_KEYWORDS=
# 讀登入帳號的首頁推薦 feed（小號先關著）
XHS_READ_FEED=0
XHS_MAX_DETAILS_PER_RUN=10
XHS_DELAY_SECONDS=5

# Instagram Graph API（需 Business/Creator 帳號）
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_HASHTAGS=torontodeals

# 公開 RSS（逗號分隔）
DEALBUDDY_FEEDS=

# ---- Vercel ----
# Postgres（在 Vercel 加 Neon 整合會自動設定 DATABASE_URL）
DATABASE_URL=
# Vercel Cron 呼叫 /cron/daily 時帶的密碼（Vercel 會自動用它）
CRON_SECRET=
# Telegram webhook 驗證用，隨便一串亂碼
TELEGRAM_WEBHOOK_SECRET=
