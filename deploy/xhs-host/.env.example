# 跟 Vercel 同一個 Postgres（Vercel 專案 → Storage → Neon → 複製 DATABASE_URL）
DATABASE_URL=
# 抽取優惠用（沒有就用離線規則）
ANTHROPIC_API_KEY=
DEALBUDDY_TZ=America/Toronto

# 小紅書 MCP 的 API 密碼（可選，建議設）
XHS_MCP_TOKEN=
# 多久完整搜一次小紅書 / IG / RSS（小時）
XHS_INTERVAL_HOURS=6
# 多久檢查一次新的意圖，有就馬上幫那位使用者搜（分鐘）
WORKER_POLL_MINUTES=10
XHS_MAX_DETAILS_PER_RUN=10
XHS_DELAY_SECONDS=5
XHS_KEYWORDS=
# 小號先不讀首頁推薦
XHS_READ_FEED=0

# 填了就會從這台主機送 Telegram 即時推（Vercel Hobby 做不到）
TELEGRAM_BOT_TOKEN=

# IG / RSS 也可以交給這台跑（Vercel 每天的 cron 也會跑一次）
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_HASHTAGS=torontodeals
DEALBUDDY_FEEDS=
